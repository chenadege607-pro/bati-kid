# Copy this file to .env and fill in your real key(s).

# Which provider to use — "groq" or "gemini". Defaults to "groq" if unset.
AI_PROVIDER=groq

# Groq (free, no credit card): get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# Gemini (free, no credit card): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

PORT=3001
